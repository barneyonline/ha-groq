#!/usr/bin/env sh
set -eu

cd "$(dirname "$0")/.."

if [ -n "${HA_IMAGE:-}" ]; then
  echo 'HA_IMAGE is no longer supported; select Core with HA_VERSION and the base with PYTHON_IMAGE.' >&2
  exit 2
fi

# Docker supplies reachable proxy addresses. Supply trust separately, without
# recording a session certificate in an image or changing Docker credentials.
if [ -n "${CODEX_PROXY_CERT:-}" ]; then
  export HA_GROQ_CA_BUNDLE=${HA_GROQ_CA_BUNDLE:-/etc/ssl/certs/ca-certificates.crt}
fi
if [ -n "${HA_GROQ_CA_BUNDLE:-}" ]; then
  [ -r "$HA_GROQ_CA_BUNDLE" ] || { echo 'CA bundle is not readable' >&2; exit 1; }
  export HA_GROQ_CONTAINER_CA=/run/ha-groq-ca.pem
fi

compose_file=devtools/docker/docker-compose.yml
project_hash=$(printf '%s\n' "$(pwd -P)" | git hash-object --stdin | cut -c1-12)
if [ "${1:-}" = "--minimum" ]; then
  shift
  project_hash="$project_hash-minimum"
  export HA_VERSION=${HA_VERSION:-2026.10.0}
  export HA_GROQ_REQUIREMENTS_FILE=requirements-min-ha.txt
fi
rebuild=false
recreate=false
if [ "${1:-}" = "--rebuild" ]; then
  rebuild=true
  shift
fi
if [ "${1:-}" = "--recreate" ]; then
  recreate=true
  shift
fi
compose_project="ha-groq-$project_hash"
git_common_dir=$(git rev-parse --path-format=absolute --git-common-dir)

export COMPOSE_PROJECT_NAME=$compose_project
export HA_GROQ_GIT_COMMON_DIR=$git_common_dir

if [ "${1:-}" = "--stop" ]; then
  docker compose -f "$compose_file" down --remove-orphans
  exit 0
fi

resolved_compose_config=$(
  HA_GROQ_TEST_ENVIRONMENT_HASH=fingerprint \
    HA_GROQ_TEST_IMAGE=ha-groq-dev:fingerprint \
    docker compose -f "$compose_file" config --format json ha-dev
)

environment_hash=$(
  {
    git hash-object \
      .dockerignore \
      devtools/docker/Dockerfile \
      devtools/docker/docker-compose.yml \
      devtools/docker/requirements-dev.txt \
      devtools/docker/requirements-min-ha.txt \
      scripts/verify_test_environment.py
    printf '%s\n' "$resolved_compose_config"
  } | git hash-object --stdin
)

export HA_GROQ_TEST_ENVIRONMENT_HASH=$environment_hash
export HA_GROQ_TEST_IMAGE="ha-groq-dev:$project_hash"

previous_image_id=$(docker image inspect --format '{{.Id}}' "$HA_GROQ_TEST_IMAGE" 2>/dev/null || true)
image_environment_hash=$(
  docker image inspect \
    --format '{{ index .Config.Labels "io.ha-groq.test-environment-hash" }}' \
    "$HA_GROQ_TEST_IMAGE" 2>/dev/null || true
)

if [ "$rebuild" = true ]; then
  docker compose -f "$compose_file" build --pull --no-cache ha-dev
elif [ "$image_environment_hash" != "$environment_hash" ]; then
  docker compose -f "$compose_file" build ha-dev
fi

if [ "$recreate" = true ]; then
  docker compose -f "$compose_file" up -d --no-build --remove-orphans --force-recreate ha-dev
else
  docker compose -f "$compose_file" up -d --no-build --remove-orphans ha-dev
fi

current_image_id=$(docker image inspect --format '{{.Id}}' "$HA_GROQ_TEST_IMAGE")
if [ -n "$previous_image_id" ] && [ "$previous_image_id" != "$current_image_id" ]; then
  docker image rm "$previous_image_id" >/dev/null 2>&1 || true
fi

docker compose -f "$compose_file" exec -T ha-dev python \
  /opt/groq-test/verify_test_environment.py \
  --expected-core-file /opt/groq-test/image-core-version

if [ "${1:-}" = "--prepare" ]; then
  exit 0
fi

if [ "$#" -eq 0 ]; then
  set -- python -m pytest -q
fi

if [ -t 0 ] && [ -t 1 ]; then
  docker compose -f "$compose_file" exec ha-dev "$@"
else
  docker compose -f "$compose_file" exec -T ha-dev "$@"
fi
